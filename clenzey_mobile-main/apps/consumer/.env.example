# Copy to .env.local and set your machine's LAN IP so a physical device can reach the backend.
# Find your IP: ipconfig getifaddr en0  (macOS Wi-Fi)
#
# IMPORTANT: localhost only works on the same machine — on a phone use your LAN IP.
# Ensure the backend listens on 0.0.0.0:3001 (not 127.0.0.1) and your firewall allows it.

EXPO_PUBLIC_API_URL=http://192.168.1.100:3001

# Razorpay test key (optional — only needed for payment flows)
# EXPO_PUBLIC_RAZORPAY_KEY=rzp_test_xxxxx
