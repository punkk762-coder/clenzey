{
  "name": "@clenzey/consumer",
  "version": "0.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_USE_NATIVE_RAZORPAY=0 expo start --go --scheme clenzey-consumer",
    "expo-go": "EXPO_USE_NATIVE_RAZORPAY=0 expo start --go --scheme clenzey-consumer",
    "dev": "EXPO_USE_NATIVE_RAZORPAY=1 expo start --dev-client --scheme clenzey-consumer",
    "web": "EXPO_USE_NATIVE_RAZORPAY=0 expo start --web",
    "android": "EXPO_USE_NATIVE_RAZORPAY=1 expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --passWithNoTests"
  },
