{
  "expo": {
    "name": "clenzey",
    "slug": "clenzey-consumer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clenzey-consumer",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0043BA"
    },
    "android": {
      "package": "com.clenzey.consumer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0043BA"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Clenzey to use your location to show nearby services."
        }
      ],
      "expo-splash-screen"
    ],
    "updates": {
      "url": "https://u.expo.dev/86ecd022-e121-4855-9d9e-df8c3005f299"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "86ecd022-e121-4855-9d9e-df8c3005f299"
      }
    },
    "owner": "punkkkkks-team"
  }
}
