{
  "expo": {
    "name": "clenzey partner",
    "slug": "clenzey-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "clenzey-partner",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00B4D8"
    },
    "android": {
      "package": "com.clenzey.partner",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#03045E"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Clenzey Partner to use your location for partner tracking while on duty."
        }
      ],
      "expo-font",
      "expo-splash-screen"
    ],
    "updates": {
      "url": "https://u.expo.dev/9ea777d2-aa61-49bc-a245-296c78cd6baa"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "9ea777d2-aa61-49bc-a245-296c78cd6baa"
      }
    },
    "owner": "punkkkkks-team"
  }
}
