{
	"name": "clenzey_backend",
	"version": "1.0.0",
	"description": "Clenzey is a tech-enabled, reliable home services platform that allows customers to book cleaning, plumbing, and electrical services quickly with transparent pricing, verified partners, and real-time tracking.",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx --watch --env-file .env.dev index.ts",
		"start": "node dist/index.js",
		"build": "tsc -p tsconfig.build.json",
		"admin:add": "tsx --env-file .env.dev scripts/add-admin.ts",
		"admin:add:prod": "tsx scripts/add-admin.ts",
		"services:seed": "tsx --env-file .env.dev scripts/seed-services.ts",
		"services:seed:prod": "tsx scripts/seed-services.ts",
		"seed": "tsx --env-file .env.dev scripts/seed.ts",
		"seed:prod": "tsx scripts/seed.ts",
		"db:dev:generate": "drizzle-kit generate --config=drizzle-dev.config.ts && sed -i '' 's/\"geography(\\([^\"]*\\))\"/geography(\\1)/g' migrations/*.sql",
		"db:dev:migrate": "drizzle-kit migrate --config=drizzle-dev.config.ts",
		"db:prod": "drizzle-kit generate && drizzle-kit migrate",
		"test": "vitest",
		"test:run": "vitest --run",
		"test:e2e": "vitest --run --config vitest.e2e.config.ts",
		"test:all": "pnpm test:run && pnpm test:e2e",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"worker": "tsx --watch --env-file .env.dev src/workers/index.ts",
		"worker:prod": "node dist/src/workers/index.js",
		"coverage": "vitest run --coverage",
		"type-check": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint --fix .",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1075.0",
		"@aws-sdk/s3-request-presigner": "^3.1075.0",
		"axios": "^1.14.0",
		"bcrypt": "^6.0.0",
		"bullmq": "^5.79.1",
		"compression": "^1.8.1",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.5",
		"cron": "^4.4.0",
		"dotenv": "^17.2.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"express": "^5.1.0",
		"express-rate-limit": "^8.5.2",
		"firebase-admin": "^13.10.0",
		"helmet": "^8.1.0",
		"ioredis": "^5.11.1",
		"jose": "^6.2.2",
		"libphonenumber-js": "^1.12.41",
		"nanoid": "^5.1.7",
		"pg": "^8.20.0",
		"rate-limit-redis": "^5.0.0",
		"razorpay": "^2.9.6",
		"socket.io": "^4.8.3",
		"swagger-jsdoc": "^6.2.8",
		"swagger-ui-express": "^5.0.1",
		"winston": "^3.17.0",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tsconfig/node-ts": "^23.6.4",
		"@tsconfig/node24": "^24.0.4",
		"@types/bcrypt": "^6.0.0",
		"@types/compression": "^1.8.1",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/cron": "^2.4.3",
		"@types/express": "^5.0.6",
		"@types/node": "^25.5.2",
		"@types/pg": "^8.20.0",
		"@types/supertest": "^7.2.0",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"@vitest/coverage-v8": "^4.1.3",
		"@vitest/eslint-plugin": "^1.6.15",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.8.0",
		"fast-check": "^4.8.0",
		"globals": "^17.4.0",
		"jiti": "^2.7.0",
		"nodemon": "^3.1.10",
		"prettier": "^3.8.1",
		"supertest": "^7.2.2",
		"tsx": "^4.20.5",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vitest": "^4.1.3"
	}
}
