# Production environment for Utho Cloud (Load Balancer + Object Storage).
# Copy to .env on the VPS:
#   cp .env.prod.example .env

# --- Database (used by docker-compose.prod.yml) ---
POSTGRES_USER=clenzey
POSTGRES_PASSWORD=change_me_strong_random_password
POSTGRES_DB=clenzey

# --- Admin build args (baked into Next.js bundle at image build time) ---
NEXT_PUBLIC_API_BASE_URL=https://api.clenzey.com/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.clenzey.com

# --- Application ---
NODE_ENV=prod
JWT_SECRET=change_me_min_32_characters_long_secret
INTERNAL_API_KEY=change_me_min_32_characters_internal_key
LOG_LEVEL=info
ENABLE_SWAGGER=false
ENABLE_RATE_LIMIT=true
DB_POOL_MAX=10
TRUST_PROXY=1

# --- CORS ---
CORS_ORIGINS=https://clenzey.com,https://www.clenzey.com,https://admin.clenzey.com
SOCKET_CORS_ORIGINS=https://admin.clenzey.com

# --- Utho Object Storage (S3-compatible) ---
OBJECT_STORAGE_BUCKET=clenzey-uploads
OBJECT_STORAGE_ENDPOINT=https://inmumbai.utho.io
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=utho_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=utho_secret_key
OBJECT_STORAGE_PUBLIC_BASE_URL=https://storage.clenzey.com
OBJECT_STORAGE_PRESIGN_EXPIRES_SEC=900
ALLOWED_UPLOAD_URL_ORIGINS=https://storage.clenzey.com,https://inmumbai.utho.io

# --- Integrations ---
MSG91_AUTH_KEY=
MSG91_SMS_FLOW_ID=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

GOOGLE_MAPS_API_KEY=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
