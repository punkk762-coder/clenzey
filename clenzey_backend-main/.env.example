# Application
NODE_ENV="dev"
PORT=3000
LOG_LEVEL="debug"
JWT_SECRET=your_access_secret_min_32_chars

# Database (required)
DATABASE_URL=""
DB_POOL_MAX=20

# HTTP CORS (comma-separated frontend origins; common localhost ports auto-allowed in dev)
# If the frontend is opened via LAN IP on another device, add it here too, e.g.:
# CORS_ORIGINS="http://192.168.1.5:4000"
CORS_ORIGINS=""

# Redis / ElastiCache (required in production; local Docker: redis://localhost:6379)
REDIS_URL=""

# Trust proxy hops (1 for ALB)
TRUST_PROXY=1

# Swagger UI (disabled by default in production)
ENABLE_SWAGGER="true"

# Rate limiting (enabled by default in production; disabled in dev for easier local testing)
ENABLE_RATE_LIMIT="false"

# Upload URL allowlist (comma-separated CDN origins; required in prod — empty allows all in dev)
ALLOWED_UPLOAD_URL_ORIGINS=""

# Object storage — S3-compatible (Utho Object Storage in production)
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_PUBLIC_BASE_URL=""
# Private bucket URL or public CDN base. With OBJECT_STORAGE_ENDPOINT set (Utho), APIs
# return presigned GET URLs for stored images.
OBJECT_STORAGE_PRESIGN_EXPIRES_SEC=900
OBJECT_STORAGE_ACCESS_KEY_ID="utho_access_key"
OBJECT_STORAGE_SECRET_ACCESS_KEY="utho_secret_key"

# MSG91 (optional in dev, required in prod for transactional/marketing SMS)
MSG91_AUTH_KEY=""
MSG91_SMS_FLOW_ID=""

# Firebase (optional in dev, required in prod — phone auth + push notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Full PEM from service account JSON private_key field; use \n for line breaks in one line:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=""

# Google Maps (optional in dev, required in prod)
GOOGLE_MAPS_API_KEY=""

# Razorpay (optional in dev, required in prod)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Dispatch engine
SCHEDULED_DISPATCH_CRON="0 22 * * *"
DISPATCH_INITIAL_RADIUS_M=5000
DISPATCH_MAX_RADIUS_M=15000
DISPATCH_RADIUS_INCREMENT_M=2000
DISPATCH_REDIRECT_INTERVAL_SEC=30
DISPATCH_ESCALATION_MIN=5
DISPATCH_LOCATION_STALE_MIN=5
DISPATCH_REVALIDATE_LEAD_MIN=30
DISPATCH_MAX_DAILY_CAPACITY=8
DISPATCH_SCHEDULED_CATCHUP_HOURS=48

# Socket.IO (comma-separated origins; defaults to localhost in dev)
SOCKET_CORS_ORIGINS=""

# Internal service-to-service API key (attendance system integration; required in prod, min 32 chars)
INTERNAL_API_KEY=""

# Payroll cron — runs daily 2 AM IST on days 1-5 of each month
PAYROLL_CRON="0 2 1-5 * *"

