# Application
NODE_ENV="dev"
PORT=3000
LOG_LEVEL="debug"
JWT_SECRET=clenzey_dev_jwt_secret_key_32chars!

# Database (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/clenzey"
DB_POOL_MAX=20

# HTTP CORS
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:4000,http://localhost:4001,http://localhost:8081,http://localhost:8082,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:4000,http://127.0.0.1:4001,http://127.0.0.1:8081,http://127.0.0.1:8082"

# Redis (optional in dev — leave empty to skip)
REDIS_URL=""

# Trust proxy
TRUST_PROXY=1

# Swagger UI
ENABLE_SWAGGER="true"

# Rate limiting (disabled for local dev)
ENABLE_RATE_LIMIT="false"

# Upload URL allowlist (empty allows all in dev)
ALLOWED_UPLOAD_URL_ORIGINS=""

# Object storage — leave empty for dev (uploads won't work but server starts)
OBJECT_STORAGE_BUCKET=""
OBJECT_STORAGE_ENDPOINT=""
OBJECT_STORAGE_REGION="auto"
OBJECT_STORAGE_PUBLIC_BASE_URL=""
OBJECT_STORAGE_PRESIGN_EXPIRES_SEC=900
OBJECT_STORAGE_ACCESS_KEY_ID=""
OBJECT_STORAGE_SECRET_ACCESS_KEY=""

# MSG91 (optional in dev)
MSG91_AUTH_KEY=""
MSG91_SMS_FLOW_ID=""

# Firebase (optional in dev)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Google Maps (optional in dev)
GOOGLE_MAPS_API_KEY=""

# Razorpay (optional in dev)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Dispatch engine
SCHEDULED_DISPATCH_CRON="0 22 * * *"
DISPATCH_INITIAL_RADIUS_M=5000
DISPATCH_MAX_RADIUS_M=15000
DISPATCH_RADIUS_INCREMENT_M=2000
DISPATCH_REDIRECT_INTERVAL_SEC=30
DISPATCH_ESCALATION_MIN=5
DISPATCH_LOCATION_STALE_MIN=5
DISPATCH_REVALIDATE_LEAD_MIN=30
DISPATCH_MAX_DAILY_CAPACITY=8
DISPATCH_SCHEDULED_CATCHUP_HOURS=48

# Socket.IO
SOCKET_CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:4000,http://localhost:4001,http://localhost:8081,http://localhost:8082,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:4000,http://127.0.0.1:4001,http://127.0.0.1:8081,http://127.0.0.1:8082"

# Internal API key (optional in dev)
INTERNAL_API_KEY=""

# Payroll cron
PAYROLL_CRON="0 2 1-5 * *"
